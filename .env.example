# Copy this file to .env, then add your Anthropic API key. Never commit the key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Keep the browser visible for the traveller's private checkout steps.
HEADLESS=0
CHAT_PORT=4200

# Per-run inference budget, in USD. Track cumulative spend separately.
AGENT_MAX_RUN_COST_USD=2
